# ---------------------------------------------------------------
# GS1 Digital Link Resolver CE — Environment Configuration
# ---------------------------------------------------------------
# How configuration is read
#   Every service loads this file first and then .env, if it exists; a value in .env replaces the
#   value here. This file therefore holds safe development defaults and is committed, while .env
#   holds the values of a real installation and is never committed (see .gitignore).
#
#   Out of the box (no .env) "docker compose up -d" runs on a development machine with the
#   example credentials below. For any server reachable by others, create .env with at least
#   new MONGO_INITDB_ROOT_PASSWORD, MONGO_URI, SESSION_TOKEN, PORTAL_DB_PASSWORD, PORTAL_SECRET_KEY and
#   FQDN values (the Ubuntu installer, scripts/install.sh, writes them).
#
#   Use URL-safe secrets (letters and digits, e.g. "openssl rand -hex 24") so that the password
#   can be placed in MONGO_URI without percent-encoding.
# ---------------------------------------------------------------

# --- MongoDB -----------------------------------------------------
# Root credentials, used by database-service on FIRST start only (when the data volume is empty).
# Changing them later does not change the database user: see the documentation for rotation.
MONGO_INITDB_ROOT_USERNAME=gs1resolver
MONGO_INITDB_ROOT_PASSWORD=gs1resolver

# Connection string used by data-entry-service and web-service. Must match the credentials above.
MONGO_URI=mongodb://gs1resolver:gs1resolver@database-service:27017

# --- Data entry API ----------------------------------------------
# Bearer token required by the data entry API (/api). Also used by the portal.
# Try not to use this particular value in production! :-)
SESSION_TOKEN=secret

# --- Public identity of the resolver -----------------------------
# Domain name of the resolver (no scheme). The resolver root is https://FQDN; it is used in
# linksets, in /.well-known/gs1resolver and in the Digital Links printed by the portal.
FQDN=localhost

# Operator shown in /.well-known/gs1resolver ("contact"; RESOLVER_ORG_URL as hasURL), in the footer of
# the home page and of the resolver's HTML pages, where the name links to RESOLVER_ORG_URL.
# Empty values are left out.
RESOLVER_ORG_NAME=My Organisation
RESOLVER_ORG_URL=
RESOLVER_CONTACT_STREET=
RESOLVER_CONTACT_LOCALITY=
RESOLVER_CONTACT_REGION=
RESOLVER_CONTACT_POSTCODE=
RESOLVER_CONTACT_COUNTRY=
RESOLVER_CONTACT_TELEPHONE=
# Optional: the operator's own terms of use, published as "termsOfUse" in /.well-known/gs1resolver.
RESOLVER_TERMS_URL=

# --- Link management portal (/portal/) ---------------------------
# Public address used in the Digital Links the portal prints and for its Origin check.
# Empty: https://FQDN. For local development without TLS set RESOLVER_PUBLIC_URL=http://localhost:8080
# in .env (session cookies then drop the Secure flag automatically).
RESOLVER_PUBLIC_URL=

# First portal user, created only while the portal has no users (never changes an existing user).
# At least 12 characters. Change the password after the first sign-in (user menu → Options).
PORTAL_ADMIN_USERNAME=admin
PORTAL_ADMIN_PASSWORD=change-me-please

# The portal's own database in the MongoDB above (users, record metadata, journal, sign-in lockout). The
# portal-db-init service creates this user, or updates its password, at every "docker compose up"; the
# user may read and write this database only. The portal is never given MONGO_URI.
PORTAL_DB_NAME=resolver_portal
PORTAL_DB_USERNAME=resolver_portal
PORTAL_DB_PASSWORD=resolver_portal

# Key that signs the portal's session cookies; every replica of the portal must share it.
# Empty: a random key kept in the portal-config volume (enough for a single portal replica).
PORTAL_SECRET_KEY=

# How long the journal keeps events, in days counted from the end of the day they happened (0 = for ever):
# sign-ins and sign-outs; record changes and imports (also how far back a record can be restored);
# user administration, password changes and exports.
PORTAL_JOURNAL_SESSION_DAYS=180
PORTAL_JOURNAL_RECORD_DAYS=0
PORTAL_JOURNAL_ADMIN_DAYS=0

# Optional: PORTAL_SESSION_IDLE_MINUTES (default 30: the session ends after this time without use),
# PORTAL_SESSION_MAX_HOURS (default 12: the session ends this long after the sign-in, whatever the use),
# PORTAL_COOKIE_SECURE (default: follows the scheme of the public address), PORTAL_DB_HOST (default
# database-service:27017), PORTAL_DB_URI (a complete MongoDB URI, e.g. an external server; replaces the
# PORTAL_DB_* connection values). PORTAL_SESSION_HOURS is no longer read.

# --- Read by Docker Compose itself (ONLY from .env, never from this file) -----
# Address on which the host publishes the proxy (port 8080) and MongoDB (port 27017).
# Default 0.0.0.0 (all interfaces). Behind a TLS reverse proxy on the same host use 127.0.0.1,
# which also keeps plain HTTP and MongoDB off the network.
# PROXY_BIND_ADDRESS=127.0.0.1
# DATABASE_BIND_ADDRESS=127.0.0.1
