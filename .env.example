# ---------------------------------------------------------------
# GS1 Digital Link Resolver CE — Environment Configuration
# ---------------------------------------------------------------
# How configuration is read
#   Every service loads this file first and then .env, if it exists; a value in .env replaces the
#   value here. This file therefore holds safe development defaults and is committed, while .env
#   holds the values of a real installation and is never committed (see .gitignore).
#
#   Out of the box (no .env) "docker compose up -d" runs on a development machine with the
#   example credentials below. For any server reachable by others, create .env with at least
#   new MONGO_INITDB_ROOT_PASSWORD, MONGO_URI, SESSION_TOKEN, PORTAL_DB_PASSWORD, PORTAL_SECRET_KEY and
#   FQDN values (the Ubuntu installer, scripts/install.sh, writes them).
#
#   Use URL-safe secrets (letters and digits, e.g. "openssl rand -hex 24") so that the password
#   can be placed in MONGO_URI without percent-encoding.
# ---------------------------------------------------------------

# --- MongoDB -----------------------------------------------------
# Root credentials, used by database-service on FIRST start only (when the data volume is empty).
# Changing them later does not change the database user: see the documentation for rotation.
MONGO_INITDB_ROOT_USERNAME=gs1resolver
MONGO_INITDB_ROOT_PASSWORD=gs1resolver

# Connection string used by data-entry-service and web-service. Must match the credentials above.
MONGO_URI=mongodb://gs1resolver:gs1resolver@database-service:27017

# --- Data entry API ----------------------------------------------
# Bearer token required by the data entry API (/api). Also used by the portal.
# Try not to use this particular value in production! :-)
SESSION_TOKEN=secret

# --- Public identity of the resolver -----------------------------
# Domain name of the resolver (no scheme). The resolver root is https://FQDN; it is used in
# linksets, in /.well-known/gs1resolver and in the Digital Links printed by the portal.
FQDN=localhost

# Operator shown in /.well-known/gs1resolver ("contact"; RESOLVER_ORG_URL as hasURL), in the footer of
# the home page and of the resolver's HTML pages, where the name links to RESOLVER_ORG_URL.
# Empty values are left out.
RESOLVER_ORG_NAME=My Organisation
RESOLVER_ORG_URL=
RESOLVER_CONTACT_STREET=
RESOLVER_CONTACT_LOCALITY=
RESOLVER_CONTACT_REGION=
RESOLVER_CONTACT_POSTCODE=
RESOLVER_CONTACT_COUNTRY=
RESOLVER_CONTACT_TELEPHONE=
# Optional: the operator's own terms of use, published as "termsOfUse" in /.well-known/gs1resolver.
RESOLVER_TERMS_URL=

# --- Link management portal (/portal/) ---------------------------
# Public address used in the Digital Links the portal prints and for its Origin check.
# Empty: https://FQDN. For local development without TLS set RESOLVER_PUBLIC_URL=http://localhost:8080
# in .env (session cookies then drop the Secure flag automatically).
RESOLVER_PUBLIC_URL=

# First portal user, created only while the portal has no users (never changes an existing user).
# At least 12 characters. Change the password after the first sign-in (user menu → Options).
PORTAL_ADMIN_USERNAME=admin
PORTAL_ADMIN_PASSWORD=change-me-please

# The portal's own database in the MongoDB above (users, record metadata, journal, sign-in lockout). The
# portal-db-init service creates this user, or updates its password, at every "docker compose up"; the
# user may read and write this database only. The portal is never given MONGO_URI.
PORTAL_DB_NAME=resolver_portal
PORTAL_DB_USERNAME=resolver_portal
PORTAL_DB_PASSWORD=resolver_portal

# Key that signs the portal's session cookies; every replica of the portal must share it.
# Empty: a random key kept in the portal-config volume (enough for a single portal replica).
PORTAL_SECRET_KEY=

# How long the journal keeps events, in days counted from the end of the day they happened (0 = for ever):
# sign-ins and sign-outs; record changes and imports (also how far back a record can be restored);
# user administration, password changes and exports.
PORTAL_JOURNAL_SESSION_DAYS=180
PORTAL_JOURNAL_RECORD_DAYS=0
PORTAL_JOURNAL_ADMIN_DAYS=0

# Where the portal's background jobs (spreadsheet imports, link checks) run: "external" in the portal-worker
# service (the standard installation), or "embedded" in a thread of the portal itself, for a minimal set-up
# without that service. Keep "external" with docker-compose.yml.
PORTAL_WORKER=external

# E-mail of the portal (Documentation/adr/0004-e-mail.md): invitations to new users, password recovery by
# single-use link, security notices and, on request, notices of finished imports and link checks. Messages go
# through an authenticated SMTP relay (the organisation's, or a sending service): port 587 with STARTTLS or 465
# with TLS ("tls"); cloud providers usually block port 25. Empty PORTAL_MAIL_HOST: e-mail is off and the portal
# works as before (temporary passwords only). The installer asks for these; the password goes in .env only.
# PORTAL_MAIL_PORT empty: 587 (starttls), 465 (tls) or 25 (none).
PORTAL_MAIL_HOST=
PORTAL_MAIL_PORT=
PORTAL_MAIL_SECURITY=starttls
PORTAL_MAIL_USERNAME=
PORTAL_MAIL_PASSWORD=
PORTAL_MAIL_FROM=
# Optional: PORTAL_MAIL_REPLY_TO (an answer address, e.g. a help desk), PORTAL_MAIL_CA_FILE (an extra
# certificate authority for a relay signed by a private one; the file must be inside the container),
# PORTAL_MAIL_TIMEOUT (default 20 seconds), PORTAL_INVITE_HOURS (default 72: validity of an invitation link),
# PORTAL_RESET_MINUTES (default 60: validity of a password recovery link).
# To try e-mail on a test installation without a relay: "docker compose --profile mail-test up -d mailpit",
# then in .env PORTAL_MAIL_HOST=mailpit, PORTAL_MAIL_PORT=1025, PORTAL_MAIL_SECURITY=none,
# PORTAL_MAIL_USERNAME= (empty), PORTAL_MAIL_FROM=portal@example.org and "docker compose up -d"; Mailpit keeps
# every message, readable at http://127.0.0.1:8025 on the server (never in production).

# The tenant API (/portal/api/v1, Documentation/adr/0005-tenant-api.md): organisations' systems use it with API keys
# their administrators create in the portal (API keys). Optional: PORTAL_API_RATE_PER_MINUTE (default 120 requests per
# key and minute), PORTAL_API_KEY_MAX_DAYS (default 365: the longest validity of a key).

# The log of resolver requests (Documentation/adr/0006-resolver-request-log.md): the resolver records each resolution
# request (key, outcome, link type, time taken, language, device class — never the client's address, User-Agent,
# serial numbers or data attribute values) in its own database, resolver_log, which the portal may only read and prune.
# Days an event (and a call of the tenant API) is kept until the portal sets it; 0 switches the log off.
RESOLVER_LOG_DAYS=90
# A header with a two-letter country code set by a proxy in front of the installation (e.g. CF-IPCountry); when present
# it wins over the GeoIP database's country (below). Empty: the database's.
RESOLVER_LOG_COUNTRY_HEADER=
# The browser family and the approximate location (country, region, city) of each request, worked out when it arrives
# (section 8 of the ADR): the client's address is read from this header (the host's nginx sets X-Real-IP; behind an
# external proxy, the header it sets; empty: the connection's address), looked up in the GeoIP database file and forgotten. scripts/geoip-update.sh downloads DB-IP's
# free City Lite database into the repository's geoip/ folder every month (GEOIP_URL: another source in the same MMDB
# format); RESOLVER_GEOIP_DB empty: no location. How long requests are kept is set in the portal (Requests → Retention);
# RESOLVER_LOG_DAYS is the default until then.
RESOLVER_LOG_ADDRESS_HEADER=X-Real-IP
RESOLVER_GEOIP_DB=/geoip/dbip-city-lite.mmdb
GEOIP_URL=
# The portal's worker counts each day's requests per key once an hour; the days are those of this time zone (an IANA
# name, e.g. America/Sao_Paulo; the installer writes the server's). The counts are kept PORTAL_STATS_DAYS days.
PORTAL_TIME_ZONE=UTC
PORTAL_STATS_DAYS=800

# Monitoring and alerts by e-mail (Documentation/adr/0008-monitoring-and-alerts.md): the worker checks the resolver
# through the proxy, the daily backup's record, the certificate of FQDN and spikes of 404, and e-mails the
# administrators (category "alerts", which each user may switch off). Optional: PORTAL_MONITOR_MINUTES (default 5; 0:
# off), PORTAL_MONITOR_URL (default http://frontend-proxy-service/.well-known/gs1resolver), PORTAL_MONITOR_PROBE (a
# GS1 Digital Link path of a registered code, e.g. /01/09506000134352, checked too), PORTAL_MONITOR_BACKUP_HOURS
# (default 26), PORTAL_MONITOR_TLS_HOST (default FQDN; empty or localhost: not checked), PORTAL_MONITOR_CERT_DAYS
# (default 21), PORTAL_MONITOR_GCP_DAYS (default 90: GS1's GCP length table in use that old or older; 0: not checked),
# PORTAL_ALERT_404_MIN (default 20) and PORTAL_ALERT_404_FACTOR (default 3: a spike is at least that
# many 404 "unknown" in an hour and that many times the usual hour of the 7 days before).

# The item's page (Documentation/adr/0011-item-page.md, item 6.2): the address of Verified by GS1 the page offers for a
# GTIN or a GLN, a template with {key} (gtin or gln) and {value}; empty: the link is not shown. Check the service's
# current address before setting it, e.g. https://www.gs1.org/services/verified-by-gs1/results?{key}={value}
RESOLVER_VERIFIED_BY_GS1_URL=

# The daily backup (scripts/resolver-backup.sh) copies each run's archives to this rsync destination too — a mounted
# folder or user@host:/path over SSH with root's key —; empty: no off-server copy. A failed copy fails the run.
BACKUP_COPY_TO=

# Single sign-on (Documentation/adr/0012-single-sign-on.md) is configured per organisation in the portal. Optional:
# PORTAL_SSO_ALLOW_INSECURE=1 accepts identity providers on http or on private addresses (tests; a provider on the
# operator's own network).
# OBSOLETE since item 9.8: export limits are set in the portal (the installation's maximum on Organisations, each
# organisation's limits per role on its page's Exports tab). PORTAL_EXPORT_LIMITS (e.g. reader:0,editor:20000) is read
# once, at the first start of that version, as the starting limits of the operator and of every organisation, and
# then no longer; remove it from .env afterwards.
PORTAL_EXPORT_LIMITS=

# Optional: PORTAL_SESSION_IDLE_MINUTES (default 30: the session ends after this time without use),
# PORTAL_SESSION_MAX_HOURS (default 12: the session ends this long after the sign-in, whatever the use),
# PORTAL_COOKIE_SECURE (default: follows the scheme of the public address), PORTAL_DB_HOST (default
# database-service:27017), PORTAL_DB_URI (a complete MongoDB URI, e.g. an external server; replaces the
# PORTAL_DB_* connection values). PORTAL_SESSION_HOURS is no longer read.

# --- Read by Docker Compose itself (ONLY from .env, never from this file) -----
# Address on which the host publishes the proxy (port 8080) and MongoDB (port 27017).
# Default 0.0.0.0 (all interfaces). Behind a TLS reverse proxy on the same host use 127.0.0.1,
# which also keeps plain HTTP and MongoDB off the network.
# PROXY_BIND_ADDRESS=127.0.0.1
# DATABASE_BIND_ADDRESS=127.0.0.1

# Containers (replicas) of each service that keeps no state of its own, 1 to 20: Compose starts this many
# and the proxy shares the requests among them. Default 1; the installer writes these four to .env. After a
# change, "docker compose up -d" adds or removes containers (the proxy finds them within 10 seconds).
# WEB_SERVICE_REPLICAS=2
# DATA_ENTRY_SERVICE_REPLICAS=1
# PORTAL_SERVICE_REPLICAS=2
# PORTAL_WORKER_REPLICAS=1
# Server processes (gunicorn) in each container of the three web services. Default 2.
# WEB_SERVICE_PROCESSES=2
# DATA_ENTRY_SERVICE_PROCESSES=2
# PORTAL_SERVICE_PROCESSES=2
