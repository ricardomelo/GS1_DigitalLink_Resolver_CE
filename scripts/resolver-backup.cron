# Daily backup at 02:30. Install as /etc/cron.d/resolver-backup (owned by root, mode 644, no
# extension in the file name) after replacing REPOSITORY with the repository's absolute path.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
30 2 * * * root REPOSITORY/scripts/resolver-backup.sh >> /var/log/resolver-backup.log 2>&1
